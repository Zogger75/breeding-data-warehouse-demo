# ============================================================
# Breeding Data Warehouse Demo Environment Settings
# ============================================================

# Option 1: SQLite local demo mode
# Recommended for reviewers who do not want to install PostgreSQL.
DATABASE_URL=sqlite:///data/processed/breeding_dw_demo.sqlite

# Option 2: PostgreSQL production-style warehouse mode
# Uncomment when PostgreSQL is installed and configured.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/breeding_dw_demo